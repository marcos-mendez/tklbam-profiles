## This is the base profile which all app-specific profiles inherit from
## See README.rst for details

# data
/opt
/srv
/home

/root
-/root/.cache # duplicity caches by default here

# system minus instance-specific stuff
/usr/local

# include /etc
/etc
# except some specific general paths
-/etc/default/grub
-/etc/grub.d
-/etc/debian_version
-/etc/turnkey_version
-/etc/ld.so.cache
-/etc/apt
-/etc/resolv.conf
-/etc/resolvconf
-/etc/network/interfaces
-/etc/passwd*
-/etc/group*
-/etc/hostname
-/etc/fstab
-/etc/mtab
-/etc/udev/rules.d
-/etc/ssh/ssh_host_*
-/etc/mysql/debian.cnf

# webmin specific
-/etc/webmin/system-status/history
-/etc/webmin/webmincron/crons

## live/installer paths - packages removed at install time
# live-tools paths (some also used by tkl-installer; no live-boot paths)
-/etc/init.d/live-tools
-/etc/live
-/etc/systemd/system/live-tools.service

# legacy live-tools paths
-/etc/rc0.d/K01live-tools
-/etc/rc6.d/K01live-tools
-/etc/rcS.d/S01live-tools

# tkl-installer paths
-/etc/systemd/system/rescue.service.d/override.conf
-/etc/systemd/system/rescue.target.d/override.conf

# legacy di-live paths
-/etc/init.d/di-live
-/etc/rc0.d/K01di-live
-/etc/rcS.d/S01di-live
-/etc/systemd/system/rescue.target.wants/di-live.service

# ec2 blacklist
-/etc/event.d/console
# legacy paths
-/usr/local/bin/ec2metadata
-/usr/local/lib/python2.6/dist-packages/ec2metadata.py*

# vmdk blacklist
-/etc/kernel-img.conf

# web content/app whitelist
/var/www
-/var/www/.composer/cache

# other than /var/www; /var is not included in backup by default, but blacklist
# specific paths that are never needed
-/var/lib/apt/lists
-/var/lib/dhcpcd
-/var/lib/fail2ban/fail2ban.sqlite3

# /var/spool is tmp data that is generally intended to survive reboot
/var/spool
-/var/spool/tklbam-squid
-/var/spool/postfix/lib
-/var/spool/postfix/private
-/var/spool/postfix/public
-/var/spool/postfix/pid
-/var/spool/postfix/dev

# dehydrated data for SSL certs
/var/lib/dehydrated

# never include tmpfs paths /tmp, /run & /var/run (symlink to /run)
-/tmp
-/run
-/var/run

# legacy shellinabox
/var/lib/shellinabox
